{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ROTA Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port=43142",
        "--web-hostname=0.0.0.0"
      ]
    },
    {
      "name": "ROTA Chrome + Supabase",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--dart-define=SUPABASE_URL=https://SEU_PROJETO.supabase.co"
      ]
    },
    {
      "name": "ROTA Android",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "android"
    },
    {
      "name": "ROTA Windows",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    }
  ]
}
